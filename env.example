# ═══════════════════════════════════════════════════════════════
# 🦉 OWL-PONTO ETL - Configuração
# ═══════════════════════════════════════════════════════════════
# 
# Renomeie este arquivo para ".env" e preencha com suas informações
# NUNCA compartilhe este arquivo (contém senhas!)
#
# ═══════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────┐
# │ CONFIGURAÇÃO DO RELÓGIO DE PONTO (Henry)                    │
# └─────────────────────────────────────────────────────────────┘

# URL completa do relógio (com http://)
RELOGIO_URL="http://192.168.15.10"

# Usuário de login do relógio
RELOGIO_USER="admin"

# Senha de login do relógio
RELOGIO_PASS="senha_do_relogio"


# ┌─────────────────────────────────────────────────────────────┐
# │ CONFIGURAÇÃO DA HOSTINGER (Servidor de Destino)             │
# └─────────────────────────────────────────────────────────────┘

# Host FTP da Hostinger (descubra no painel hPanel → Contas FTP)
HOSTINGER_FTP_HOST="ftp.rederwp.com"

# Usuário FTP (apenas o código, SEM domínio)
# ✅ CORRETO: u504951644
# ❌ ERRADO: u504951644.rederwp.com
HOSTINGER_FTP_USER="u504951644"

# Senha FTP da Hostinger
HOSTINGER_FTP_PASS="sua_senha_ftp"

# Pasta de destino no servidor (sempre termine com "/")
HOSTINGER_REMOTE_FOLDER_PATH="/public_html/pontos/"


# ┌─────────────────────────────────────────────────────────────┐
# │ IDENTIFICADOR ÚNICO DA MÁQUINA                               │
# └─────────────────────────────────────────────────────────────┘

# Use um ID único para cada loja/máquina
# Exemplos: LOJA_01, MATRIZ_01, FILIAL_CENTRO
MACHINE_ID="LOJA_01"


# ═══════════════════════════════════════════════════════════════
# ✅ CONFIGURAÇÃO COMPLETA!
# ═══════════════════════════════════════════════════════════════
# 
# Próximos passos:
# 1. Salve este arquivo como ".env"
# 2. Execute: npm install
# 3. Teste: npm start
# 4. Agende no Windows (veja README.md)
#
# ═══════════════════════════════════════════════════════════════

